<UserControl x:Class="AboutMyDevice.Features.BatteryInfo.Views.BatteryInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ListView Grid.Row="0" ItemsSource="{Binding BatteryInfo}" BorderThickness="0" AutomationProperties.Name="Battery Info">
      <ListView.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Display}" TextWrapping="Wrap" />
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
    <Button Grid.Row="1"
            Content="_Copy Battery info to clipboard"
            Command="{Binding CopyCommand}"
            HorizontalAlignment="Right" />
  </Grid>
</UserControl>
